{
  "layer": "top",
  "modules-left": [
    "custom/launcher",
    "cpu",
    "memory",
    "idle_inhibitor",
    "tray",
    "clock",
    "mpris",
  ],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "privacy",
    "custom/weather",
    "backlight",
    "pulseaudio",
    "custom/sink-toggle",
    "battery",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    // "show-special": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂱 {volume}% ",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""],
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pavucontrol",
  },
  "network": {
    "tooltip": false,
    "format-wifi": "  {essid}",
    "format-ethernet": "",
  },
  "backlight": {
    "tooltip": false,
    "format": " {}%",
    "interval": 1,
    "scroll-step": 5,
    "on-click": "brightnessctl set 100%",
    "on-click-right": "brightnessctl set 0",
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
  },
  "clock": {
    "format": "{:%H:%M %B %d %Y}",
  },
  "cpu": {
    "interval": 15,
    "format": " {}%",
    "max-length": 10,
  },
  "memory": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10,
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": { "default": "\uf001", "firefox": "\uf269" },
    "status-icons": { "paused": "\uf04c" },
    "dynamic-order": ["title", "artist", "position", "length"],
    "title-len": 30,
    "artist-len": 20,
    "max-length": 55,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
  },
  "custom/launcher": {
    "format": " ",
    "on-click": "pkill rofi || rofi -show drun -show-icons",
  },
  "custom/power": {
    "format": " ",
    "on-click": " pkill rofi || rofi -show power-menu -modi power-menu:rofi-power-menu",
  },
  "privacy": {
    "icon-size": 18,
    "icon-spacing": 6,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true },
    ],
  },
  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 600,
    "exec": "$HOME/.config/waybar/modules/weather.py",
    "on-click": "firefox https://wttr.in/Ankara",
    "return-type": "json",
  },
  "custom/sink-toggle": {
    "format": "{} ",
    "tooltip": true,
    "interval": 2,
    "exec": "$HOME/.config/waybar/modules/sink-toggle.sh",
    "on-click": "fish -c toggle-sink",
    "return-type": "json",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf0eb",
      "deactivated": "\uf186",
    },
    "tooltip-format-activated": "Idle inhibited \u2013 screen stays awake",
    "tooltip-format-deactivated": "Idle timers active",
  },
}
