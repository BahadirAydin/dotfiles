{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "privacy",
    "network",
    "custom/weather",
    "backlight",
    "pulseaudio",
    "custom/sink-toggle",
    "idle_inhibitor",
    "battery",
    "tray",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },
  "mpris": {
    "format": "<span foreground='#e9b949'>{player_icon}</span>\u2003<span foreground='#e8e8ea'>{title}</span><span foreground='#76777d'>\u2003{artist}</span>",
    "format-paused": "<span foreground='#8a6f2c'>{status_icon}</span>\u2003<span foreground='#9a9aa0'><i>{title}</i></span><span foreground='#5e5f65'><i>\u2003{artist}</i></span>",
    "player-icons": {
      "default": "\uf001",
      "firefox": "\uf269"
    },
    "status-icons": {
      "paused": "\uf04c"
    },
    "title-len": 26,
    "artist-len": 16,
    "max-length": 42,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },
  "clock": {
    "format": "{:%a %d %b   %H:%M}",
    "tooltip": false
  },
  "privacy": {
    "icon-size": 14,
    "icon-spacing": 8,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true
      },
      {
        "type": "audio-in",
        "tooltip": true
      }
    ]
  },
  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 600,
    "return-type": "json",
    "exec": "$HOME/.config/waybar/modules/weather.py",
    "on-click": "firefox https://wttr.in/Ankara"
  },
  "backlight": {
    "tooltip": false,
    "format": "\uf185\u2003{}%",
    "scroll-step": 5,
    "on-click": "brightnessctl set 100%",
    "on-click-right": "brightnessctl set 0"
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon}\u2003{volume}%",
    "format-muted": "\uf028",
    "format-icons": {
      "default": [
        "\uf028",
        "\uf027",
        "\uf027"
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pavucontrol"
  },
  "custom/sink-toggle": {
    "format": "{}",
    "tooltip": true,
    "interval": 10,
    "signal": 8,
    "return-type": "json",
    "exec": "$HOME/.config/waybar/modules/sink-toggle.sh",
    "on-click": "fish -c toggle-sink"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf0eb",
      "deactivated": "\uf186"
    },
    "tooltip-format-activated": "Idle inhibited",
    "tooltip-format-deactivated": "Idle timers active"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}\u2003{capacity}%",
    "format-charging": "\uf0e7\u2003{capacity}%",
    "format-plugged": "\uf0e7\u2003{capacity}%",
    "format-alt": "{time}",
    "format-icons": [
      "\uf240",
      "\uf240",
      "\uf240",
      "\uf240",
      "\uf240"
    ],
    "tooltip": false
  },
  "tray": {
    "icon-size": 15,
    "spacing": 12
  },
  "custom/power": {
    "format": "\uf011",
    "on-click": "pkill rofi || rofi -show power-menu -modi power-menu:rofi-power-menu"
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false,
    "max-length": 16
  },
  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "max-length": 55,
    "rewrite": {
      "(.*) \u2014 Mozilla Firefox": "$1",
      "(.*) - Mozilla Firefox": "$1",
      "^Mozilla Firefox$": "Firefox",
      "(.*) - NVIM": "$1",
      "^$": ""
    }
  },
  "network": {
    "tooltip": true,
    "format-wifi": "\uf1eb\u2003{essid}",
    "format-ethernet": "\uf0e8\u2003wired",
    "format-disconnected": "\uf127",
    "format-linked": "\uf127",
    "tooltip-format-wifi": "{essid}  {signalStrength}%  \u2022  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  \u2022  {ipaddr}",
    "tooltip-format-disconnected": "offline",
    "max-length": 22,
    "on-click": "nm-connection-editor"
  }
}
