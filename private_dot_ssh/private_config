Host github.com
    IdentityFile ~/.ssh/github/id_rsa

Host gitlab.ceng.metu.edu.tr
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/gitlab/id_ed25519

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath /run/user/%i/ssh-%C
    ControlPersist 10m
